// Nodo Business Search — Prisma schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ─── Auth.js models ──────────────────────────────────────────────
model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  role          Role         @default(USER)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  accounts      Account[]
  sessions      Session[]
  searches      Search[]
  leadExports   LeadExport[]
}

enum Role {
  USER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Business search domain ──────────────────────────────────────
model Search {
  id           String   @id @default(cuid())
  userId       String
  query        String
  resultsCount Int
  leadsCreated Int
  createdAt    DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  leads Lead[]

  @@index([createdAt])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DISCARDED
  EXPORTED
}

model Lead {
  id             String       @id @default(cuid())
  placeId        String       @unique
  name           String
  address        String?
  phone          String?
  category       String?
  types          String[]
  lat            Float?
  lng            Float?
  hasWebsite     Boolean      @default(false)
  websiteUri     String?
  status         LeadStatus   @default(NEW)
  notes          String?
  sourceSearchId String?
  rawJson        Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  sourceSearch Search?      @relation(fields: [sourceSearchId], references: [id])
  exports      LeadExport[]

  @@index([status])
  @@index([createdAt])
}

model LeadExport {
  id            String   @id @default(cuid())
  leadId        String
  userId        String
  trelloCardId  String
  trelloListId  String
  trelloBoardId String
  exportedAt    DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([leadId, trelloBoardId])
  @@index([exportedAt])
}
