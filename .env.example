# Auth.js
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated allowlist of sign-in emails
AUTH_ALLOWED_EMAILS=contact@nodo.co.nz,pato.anabalon@gmail.com

# Database (Neon via Vercel Marketplace — auto-provisioned by `vercel env pull`)
# Prisma uses the pooled Prisma URL for runtime and the non-pooling URL for migrations.
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Google Places API (New)
GOOGLE_PLACES_API_KEY=

# Trello REST API
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
TRELLO_LIST_ID=
